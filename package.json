{
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "name": "it-compromise",
  "description": "modesta elaborazione del linguaggio naturale per javascript",
  "version": "0.3.1",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=12"
  },
  "main": "./builds/it-compromise.mjs",
  "browser": "./builds/it-compromise.min.js",
  "unpkg": "./builds/it-compromise.min.js",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./builds/it-compromise.mjs",
      "require": "./builds/it-compromise.cjs"
    }
  },
  "types": "types/index.d.ts",
  "repository": "github:nlp-compromise/it-compromise",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "scripts": {
    "test": "pnpm run check-types && tape \"./tests/**/*.test.js\" | tap-dancer",
    "check-types": "tsc -p tsconfig.json",
    "testb": "cross-env TESTENV=prod pnpm run test",
    "build": "pnpm run version && rollup -c --silent",
    "prepack": "pnpm run build && pnpm run testb && pnpm run lint",
    "pack": "node ./scripts/pack.js",
    "match": "node ./scripts/match.js",
    "watch": "node --watch ./scratch.js",
    "lint": "eslint ./src/**/*",
    "version": "node ./scripts/version.js",
    "score": "node ./learn/tagger/test.js",
    "stress": "node scripts/stress.js"
  },
  "files": [
    "builds/",
    "types/",
    "src/"
  ],
  "dependencies": {
    "compromise": "^14.17.0",
    "efrt": "2.7.0",
    "suffix-thumb": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "cross-env": "10.1.0",
    "eslint": "10.10.0",
    "eslint-plugin-regexp": "3.3.0",
    "globals": "17.12.0",
    "it-corpus": "^0.0.1",
    "rollup": "4.63.1",
    "tap-dancer": "0.4.0",
    "tape": "5.10.2",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
